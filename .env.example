# ─── Database (required) ──────────────────────────────────────────────────────
# Leave the placeholder as-is: `bun run init` derives the database name from
# your project folder (my-app → my_app). Set your own URL here to override.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/indigo

# ─── Auth (required) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
# AUTH_BLOCK_DISPOSABLE_EMAILS=true   # Reject throwaway-provider addresses (mailinator & co.) at sign-up

# ─── Application (required) ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Indigo
NODE_ENV=development
PORT=3000

# ─── Admin ────────────────────────────────────────────────────────────────────
# Set to true to allow self-registration at /dashboard/register
NEXT_PUBLIC_ADMIN_REGISTRATION_ENABLED=false

# ─── Organizations ───────────────────────────────────────────────────────────
# Show org UI (OrgSwitcher, org management). Default: true.
# Personal org is always auto-created for billing/tokens, even when false.
# Set to false for B2C apps that don't need multi-org.
NEXT_PUBLIC_ORGANIZATIONS_VISIBLE=true

# ─── Server ──────────────────────────────────────────────────────────────────
# SERVER_ROLE: all | frontend | api | worker
SERVER_ROLE=all

# ─── Ops (optional) ──────────────────────────────────────────────────────────
# LOG_LEVEL=warn                # debug | info | warn | error. Default: debug in dev, info in prod
# MEMORY_MAX_RSS_MB=1600        # Graceful self-restart when RSS crosses this (jittered ±10%/boot
#                               # so replicas restart rolling, never in lockstep). Set ~75-80% of
#                               # the container memory cap. Off by default; Linux only.
# BULLMQ_PREFIX=bull            # Isolate BullMQ keys when several servers share one Redis
#                               # (worktree slots, a test server) — else they consume each other's jobs
# WS_ENABLED=true               # false = run without the WebSocket server
# WS_MAX_PAYLOAD_BYTES=1048576  # Inbound WS frame cap (1 MiB); raise only for modules streaming binary
# WS_PERMESSAGE_DEFLATE=false   # WS compression, off by default (zlib fragmentation grows RSS under load)
# TRUSTED_PROXY_HOPS=1          # Proxies you control in front of the app (CDN → LB → app = 2);
#                               # picks which x-forwarded-for entry is the client IP
# AUDIT_LOG_RETENTION_DAYS=     # Overrides infra.audit.retentionDays for the daily audit-log purge
#
# All of the above are validated at boot (src/lib/env.ts) — a typo fails startup
# rather than silently falling back to the default. Cross-field rules also fail
# boot: STORAGE_BACKEND=s3 without the S3_* keys, MEDIA_FALLBACK_STORE without
# MEDIA_FALLBACK_URL, EMAIL_LIST_PROVIDER without its provider keys, and
# SERVER_ROLE=worker without REDIS_URL.

# ─── Redis (optional — enables BullMQ email queue) ──────────────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ─── Email / SMTP (optional) ────────────────────────────────────────────────
# Without SMTP config, emails are logged to console in development
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=noreply@example.com
# Staff inboxes for operational alerts (webhook failures) — comma-separated.
# Unset: alerts are logged only.
# STAFF_ALERT_EMAILS=ops@example.com
# Staff support inbox fallback when Settings → Company has none.
# SUPPORT_EMAIL=support@example.com

# ─── Social Login (optional) ────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_DISCORD_CLIENT_ID=

# ─── Storage ────────────────────────────────────────────────────────────────
# filesystem (default) or s3
STORAGE_BACKEND=filesystem

# S3-compatible storage (required when STORAGE_BACKEND=s3)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=indigo-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_CDN_URL=

# Missing-media fallback — where to fetch files that aren't on this machine.
# Point it at production storage after importing a prod DB dump locally, and
# every image resolves instead of 404ing. Full URL prefix; the request path is
# appended. Unset (default) = plain 404, so production never proxies elsewhere.
# MEDIA_FALLBACK_URL=https://cdn.example.com
# MEDIA_FALLBACK_STORE=true   # also mirror fetched bytes into ./uploads

# Uploaded originals are auto-oriented, stripped of EXIF/GPS/XMP and capped to
# this many px on the longest side (format preserved; GIF/SVG/animated pass
# through). 0 keeps full resolution — orientation + metadata stripping stay on.
# UPLOAD_MAX_IMAGE_PX=2560

# ─── Stripe (optional — billing disabled without secret key) ──────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe price IDs — create in Stripe dashboard, one per plan × interval
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_YEARLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# ─── NOWPayments (optional — crypto payments disabled without API key) ──────
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_SANDBOX=true

# ─── DeepL Translation (optional) ──────────────────────────────────────────
# DEEPL_API_KEY=
# DEEPL_API_FREE=true

# ─── Encryption (auto-generated by `bun run init`) ────────────────────────
# 64-char hex key for AES-256-GCM encryption of stored credentials
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# ─── ElevenLabs (optional — voice calls disabled without API key) ─────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_DEFAULT_VOICE_ID=

# ─── Mock AI (set to true for local dev without API keys) ─────────────────
# MOCK_AI=true

# ─── WebSocket ──────────────────────────────────────────────────────────────
# WS_ENABLED=true

# ─── AI Assist (optional — editor AI features disabled without API key) ───
# AI_API_KEY=
# AI_API_URL=
# AI_MODEL=

# ─── Email List / Newsletter (optional) ──────────────────────────────────
# EMAIL_LIST_PROVIDER=mailchimp
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=
# BREVO_API_KEY=
# BREVO_LIST_ID=

# ─── Web Push / VAPID (optional — push notifications disabled without keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Registration ───────────────────────────────────────────────────────
NEXT_PUBLIC_REGISTRATION_ENABLED=true

# ─── Support Chat ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_CHAT_ENABLED=true

# ─── Sentry (optional — error tracking disabled without DSN) ──────────────
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# ─── Docker Compose (used by docker-compose.prod.yml) ─────────────────────
# Generate with: openssl rand -hex 16
# POSTGRES_PASSWORD=change-me
